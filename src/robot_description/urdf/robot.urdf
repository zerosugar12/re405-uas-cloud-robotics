<?xml version="1.0" encoding="utf-8"?>
<robot name="robot">

  <link name="robot">
    <inertial>
      <origin xyz="-0.088 -0.038 0.07" rpy="0 0 0"/>
      <mass value="0.381416"/>
      <inertia ixx="0.000443" ixy="0.0" ixz="0.0" iyy="0.000767" iyz="0.0" izz="0.001196"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 -1.5708"/>
      <geometry>
        <mesh filename="package://robot_description/meshes/robot.STL"/>
      </geometry>
      <material name="">
        <color rgba="0.85 0.55 0.08 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="-0.088 -0.038 0.09" rpy="0 0 -1.5708"/>
      <geometry>
        <box size="0.20 0.18 0.08"/>
      </geometry>
    </collision>
  </link>

  <link name="right_wheel">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.0214028"/>
      <inertia ixx="8.628e-06" ixy="0.0" ixz="0.0" iyy="8.628e-06" iyz="0.0" izz="1.451e-05"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://robot_description/meshes/right_wheel.STL"/>
      </geometry>
      <material name="">
        <color rgba="0.792 0.820 0.933 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.034" length="0.025"/>
      </geometry>
    </collision>
  </link>

  <joint name="rw" type="continuous">
    <origin xyz="-0.088156 -0.118440 0.068553" rpy="-1.5708 -0.44143 3.14159"/>
    <parent link="robot"/>
    <child link="right_wheel"/>
    <axis xyz="0 0 -1"/>
    <dynamics damping="0.01" friction="0.1"/>
  </joint>

  <link name="left_wheel">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.0214028"/>
      <inertia ixx="8.628e-06" ixy="0.0" ixz="0.0" iyy="8.628e-06" iyz="0.0" izz="1.451e-05"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://robot_description/meshes/left_wheel.STL"/>
      </geometry>
      <material name="">
        <color rgba="0.792 0.820 0.933 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.034" length="0.025"/>
      </geometry>
    </collision>
  </link>

  <joint name="lw" type="continuous">
    <origin xyz="-0.088663 0.042565 0.068553" rpy="-1.5708 1.3841 0"/>
    <parent link="robot"/>
    <child link="left_wheel"/>
    <axis xyz="0 0 1"/>
    <dynamics damping="0.01" friction="0.1"/>
  </joint>

  <link name="front_free_wheel">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.001987"/>
      <inertia ixx="5.743e-08" ixy="0.0" ixz="0.0" iyy="6.238e-08" iyz="0.0" izz="3.913e-08"/>
    </inertial>
    <visual>
      <origin xyz="0.15 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://robot_description/meshes/front_free_wheel.STL"/>
      </geometry>
      <material name="">
        <color rgba="0.792 0.820 0.933 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.012"/>
      </geometry>
    </collision>
  </link>

  <joint name="ff" type="continuous">
    <origin xyz="-0.014156 -0.037935 0.049093" rpy="1.5708 0 3.14159"/>
    <parent link="robot"/>
    <child link="front_free_wheel"/>
    <axis xyz="0 1 0"/>
    <dynamics damping="0.005" friction="0.05"/>
  </joint>

  <link name="back_free_wheel">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.001987"/>
      <inertia ixx="5.743e-08" ixy="0.0" ixz="0.0" iyy="6.238e-08" iyz="0.0" izz="3.913e-08"/>
    </inertial>
    <visual>
      <origin xyz="-0.0 0 0" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.0001"/>
      </geometry>
      <material name="">
        <color rgba="0.792 0.820 0.933 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.012"/>
      </geometry>
    </collision>
  </link>

  <joint name="bf" type="continuous">
    <origin xyz="-0.16216 -0.037935 0.049093" rpy="0 0 -1.5708"/>
    <parent link="robot"/>
    <child link="back_free_wheel"/>
    <axis xyz="0 1 0"/>
    <dynamics damping="0.005" friction="0.05"/>
  </joint>

  <link name="imu_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.001"/>
      <inertia ixx="1e-06" ixy="0.0" ixz="0.0" iyy="1e-06" iyz="0.0" izz="1e-06"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.02 0.02 0.01"/>
      </geometry>
      <material name="blue">
        <color rgba="0.0 0.0 1.0 1.0"/>
      </material>
    </visual>
  </link>

  <joint name="imu_joint" type="fixed">
    <origin xyz="-0.088 -0.038 0.09" rpy="0 0 -1.5708"/>
    <parent link="robot"/>
    <child link="imu_link"/>
  </joint>

  <gazebo reference="right_wheel">
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
    <kp>1000000.0</kp>
    <kd>100.0</kd>
    <visual>
      <material>
        <ambient>0.792 0.820 0.933 1</ambient>
        <diffuse>0.792 0.820 0.933 1</diffuse>
        <specular>0.1 0.1 0.1 1</specular>
      </material>
    </visual>
  </gazebo>

  <gazebo reference="left_wheel">
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
    <kp>1000000.0</kp>
    <kd>100.0</kd>
    <visual>
      <material>
        <ambient>0.792 0.820 0.933 1</ambient>
        <diffuse>0.792 0.820 0.933 1</diffuse>
        <specular>0.1 0.1 0.1 1</specular>
      </material>
    </visual>
  </gazebo>

  <gazebo reference="front_free_wheel">
    <mu1>0.0</mu1>
    <mu2>0.0</mu2>
    <kp>1000000.0</kp>
    <kd>100.0</kd>
    <visual>
      <material>
        <ambient>0.792 0.820 0.933 1</ambient>
        <diffuse>0.792 0.820 0.933 1</diffuse>
        <specular>0.1 0.1 0.1 1</specular>
      </material>
    </visual>
  </gazebo>

  <gazebo reference="back_free_wheel">
    <mu1>0.0</mu1>
    <mu2>0.0</mu2>
    <kp>1000000.0</kp>
    <kd>100.0</kd>
    <visual>
      <material>
        <ambient>0.792 0.820 0.933 1</ambient>
        <diffuse>0.792 0.820 0.933 1</diffuse>
        <specular>0.1 0.1 0.1 1</specular>
      </material>
    </visual>
  </gazebo>

  <gazebo reference="imu_link">
    <visual>
      <material>
        <ambient>0.0 0.0 1.0 1</ambient>
        <diffuse>0.0 0.0 1.0 1</diffuse>
        <specular>0.1 0.1 0.1 1</specular>
      </material>
    </visual>
    <sensor name="imu_sensor" type="imu">
      <always_on>true</always_on>
      <update_rate>100</update_rate>
      <topic>/imu</topic>
      <imu>
        <angular_velocity>
          <x><noise type="gaussian"><mean>0</mean><stddev>0.009</stddev></noise></x>
          <y><noise type="gaussian"><mean>0</mean><stddev>0.009</stddev></noise></y>
          <z><noise type="gaussian"><mean>0</mean><stddev>0.009</stddev></noise></z>
        </angular_velocity>
        <linear_acceleration>
          <x><noise type="gaussian"><mean>0</mean><stddev>0.021</stddev></noise></x>
          <y><noise type="gaussian"><mean>0</mean><stddev>0.021</stddev></noise></y>
          <z><noise type="gaussian"><mean>0</mean><stddev>0.021</stddev></noise></z>
        </linear_acceleration>
      </imu>
    </sensor>
  </gazebo>

  <gazebo>
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>lw</left_joint>
      <right_joint>rw</right_joint>
      <wheel_separation>0.1768</wheel_separation>
      <wheel_radius>0.034</wheel_radius>
      <odom_publish_frequency>50</odom_publish_frequency>
      <topic>/cmd_vel</topic>
      <odom_topic>/odom</odom_topic>
      <tf_topic>/tf</tf_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>robot</child_frame_id>
      <publish_odom_tf>true</publish_odom_tf>
    </plugin>
  </gazebo>

  <gazebo>
    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
      <topic>/joint_states</topic>
    </plugin>
  </gazebo>

</robot>
